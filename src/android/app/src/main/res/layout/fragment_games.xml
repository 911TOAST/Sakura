<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/games_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/suyu_surface"
    android:clipChildren="false">

    <!-- Optional user background: sits behind every other child, blurred and dimmed by
         LibraryBackgroundApplier when a picture is selected. -->
    <ImageView
        android:id="@+id/library_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/library_background_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Aurora veil: palette-tinted ambient glow above the picture, below the content.
         Driven by LibraryBackgroundApplier; stays gone without a wallpaper. -->
    <org.yuzu.yuzu_emu.views.AuroraVeilView
        android:id="@+id/library_aurora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Brand row: logo, wordmark, and the two primary actions. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/brand_mark"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/sakura_icon_tile">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/sakura_flower"
                app:tint="?attr/colorOnPrimaryContainer" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brand_wordmark_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sakura_display"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textScaleX="1.15"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/brand_tagline_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/google_sans_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:text="@string/home_tagline"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Only visible when a newer release is known. Tapping opens the update page. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_pill"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/update_pill"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="18dp"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_button"
            style="@style/Widget.Suyu.IconButton"
            android:contentDescription="@string/home_change_view">

            <ImageView
                android:id="@+id/view_icon"
                android:layout_width="@dimen/m3_icon_size"
                android:layout_height="@dimen/m3_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_m3_grid_view"
                app:tint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Section headline with a live game count. -->
    <LinearLayout
        android:id="@+id/library_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/home_library"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/library_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_count_pill"
            android:fontFamily="@font/google_sans_medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            tools:text="12 games" />
    </LinearLayout>

    <!-- Search. -->
    <FrameLayout
        android:id="@+id/frame_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_header">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/m3_search_height"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_large"
                android:layout_marginEnd="@dimen/m3_search_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_m3_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/google_sans_regular"
                    android:gravity="center_vertical|start"
                    android:hint="@string/home_search_games"
                    android:imeOptions="flagNoFullscreen"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:letterSpacing="0.005"
                    android:maxLines="1"
                    android:paddingVertical="0dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/clear_button"
                android:layout_width="@dimen/m3_touch_target_size"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/spacing_small"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/home_clear_search"
                android:focusable="true"
                android:visibility="invisible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_m3_close"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Quick library filters. -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frame_search">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_all"
                style="@style/SuyuFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/home_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_alphabetical"
                style="@style/SuyuFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_filter_az" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_recent"
                style="@style/SuyuFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_filter_recent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_new"
                style="@style/SuyuFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_filter_new" />

            <com.google.android.material.chip.Chip
                android:id="@+id/filter_favorites"
                style="@style/SuyuFilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_filter_favorites" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Library content. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_scroll">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="16dp"
                android:paddingEnd="32dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_empty_icon">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_m3_sports_esports"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty_state_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/google_sans_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/empty_library_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/notice_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/google_sans_regular"
                    android:gravity="center"
                    android:letterSpacing="0.005"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="320dp"
                    android:text="@string/empty_gamelist"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_empty_add"
                    style="@style/SuyuButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/choose_game_folder"
                    app:icon="@drawable/ic_m3_create_new_folder"
                    app:iconPadding="10dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingHorizontal="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="24dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Add a game folder. Shown with the native M3 FAB entrance once the library loads. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_directory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/choose_game_folder"
        android:src="@drawable/ic_m3_create_new_folder"
        android:visibility="gone"
        app:backgroundTint="?attr/colorPrimaryContainer"
        app:elevation="1dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@id/nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="24dp"
        app:tint="?attr/colorOnPrimaryContainer" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_nav_pill"
        android:elevation="6dp"
        android:fitsSystemWindows="false"
        app:itemActiveIndicatorStyle="@style/Widget.Suyu.NavActiveIndicator"
        app:itemTextAppearanceActive="?attr/textAppearanceLabelLarge"
        app:itemTextAppearanceInactive="?attr/textAppearanceLabelMedium"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_home_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>
