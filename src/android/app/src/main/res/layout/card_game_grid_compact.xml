<!-- Compact library card: one 3:2 crop with the label over its lower edge. The card fills its
     grid cell, so a three-column preset no longer clips neighbours on a narrow screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_game_grid_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:clipToPadding="true"
        android:focusable="true"
        android:transitionName="card_game_compact"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_game_screen_compact"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:transitionName="game_artwork"
                app:layout_constraintDimensionRatio="3:2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.sakura.GameArtwork"
                tools:src="@drawable/default_icon" />

            <View
                android:id="@+id/gradient_overlay_bottom"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/gradient_overlay_bottom"
                app:layout_constraintBottom_toBottomOf="@id/image_game_screen_compact"
                app:layout_constraintEnd_toEndOf="@id/image_game_screen_compact"
                app:layout_constraintStart_toStartOf="@id/image_game_screen_compact"
                app:layout_constraintTop_toTopOf="@id/image_game_screen_compact" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_game_title_compact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_medium"
                android:letterSpacing="0.004"
                android:maxLines="2"
                android:shadowColor="@android:color/black"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textAlignment="viewStart"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/image_game_screen_compact"
                app:layout_constraintEnd_toEndOf="@id/image_game_screen_compact"
                app:layout_constraintStart_toStartOf="@id/image_game_screen_compact"
                tools:text="Your Game Title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>