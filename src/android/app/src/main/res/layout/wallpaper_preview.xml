<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/suyu_surface" android:clipChildren="true">
    <ImageView android:id="@+id/library_background"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:contentDescription="@null" />
    <View android:id="@+id/library_background_scrim"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wallpaper_preview_games" android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center">
            <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_margin="4dp" android:alpha="0.65" android:background="?attr/colorSurfaceContainerHigh" />
            <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1"
                android:layout_margin="4dp" android:alpha="0.65" android:background="?attr/colorSurfaceContainerHigh" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/wallpaper_preview" android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</FrameLayout>
