    </style>

    <!-- suyu theme styles -->
    <style name="SuyuSlider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorOutline</item>
        <item name="thumbColor">?attr/colorSecondary</item>
        <item name="haloColor">?attr/colorSecondary</item>
    </style>

    <style name="SuyuMaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">?attr/colorOnSurfaceVariant</item>
        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="buttonBarPositiveButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
        <item name="buttonBarNegativeButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
        <item name="buttonBarNeutralButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
    </style>

    <style name="YuzuMaterialDialog.Sakura" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">?attr/colorOnSurfaceVariant</item>
        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="buttonBarPositiveButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
        <item name="buttonBarNegativeButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
        <item name="buttonBarNeutralButtonStyle">@style/YuzuButton.Dialog.Sakura</item>
    </style>

    <style name="YuzuButton.Dialog.Sakura" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="SuyuButton.Dialog.Sakura" parent="YuzuButton.Dialog.Sakura" />

    <style name="SuyuButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.suyu.TransparentTopAppBarLayout" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="liftOnScroll">false</item>
        <item name="statusBarForeground">@android:color/transparent</item>
    </style>

    <style name="Widget.suyu.TransparentTopToolbar" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="SuyuPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>
    <style name="YuzuPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="SuyuButton.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/m3_touch_target_size</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <!-- M3 Expressive: 28dp = full-pill feel on standard button height -->
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="SuyuButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/m3_touch_target_size</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans_medium</item>
        <!-- M3 Expressive: match primary pill radius -->
        <item name="cornerRadius">28dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="SuyuButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/m3_touch_target_size</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Suyu.Full</item>
    </style>

    <!-- Lowest-emphasis action: same metrics as the pill buttons without the container. -->
    <style name="SuyuButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/m3_touch_target_size</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Suyu.Full</item>
    </style>

    <style name="Widget.Suyu.IconButton" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">@dimen/m3_touch_target_size</item>
        <item name="android:layout_height">@dimen/m3_touch_target_size</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Suyu.Full</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="SuyuCard" parent="">
        <item name="android:background">@drawable/theme_card_background</item>
        <item name="android:elevation">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SuyuGameCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">0dp</item>
        <!-- M3 Expressive: 28dp game-card corner (was 20dp) -->
        <item name="cardCornerRadius">28dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SuyuCardElevated" parent="">
        <item name="android:background">@drawable/suyu_card_elevated_selector</item>
        <item name="android:elevation">0dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Clean typography styles for cards and legacy surfaces. -->
    <style name="SynthwaveText.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:shadowRadius">0</item>
    </style>
    <style name="SynthwaveText.Header" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0.004</item>
        <item name="android:shadowRadius">0</item>
    </style>
    <style name="SynthwaveText.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0.008</item>
    </style>
    <style name="SynthwaveText.Secondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0.012</item>
        <item name="android:shadowRadius">0</item>
    </style>
    <style name="SynthwaveText.Accent" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:shadowRadius">0</item>
    </style>
    <!-- Shape appearance for carousel images -->
    <style name="ShapeAppearance.suyu.CarouselImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <style name="ShapeAppearance.sakura.GameArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
    </style>

    <!-- Grid card artwork: rounded on the top corners only, so the label block under it sits
         flush. 24dp matches the card's own corner radius. -->
    <style name="ShapeAppearance.sakura.GameArtworkTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Cover art on the boot/loading surface: one large expressive radius. -->
    <style name="ShapeAppearance.Suyu.LoadingArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>
    <style name="ShapeAppearance.sakura.CarouselArtwork" parent="">
        <item name="cornerFamily">rounded</item>
        <!-- 32dp: matches large surface container shape in M3 Expressive -->
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">32dp</item>
        <item name="cornerSizeBottomRight">32dp</item>
    </style>

    <!-- M3 Expressive filter chip: fully rounded, vivid tonal background. -->
    <style name="SuyuFilterChip" parent="Widget.Material3.Chip.Filter">
        <!-- 50% = pill — M3 Expressive uses fully-rounded chips -->
        <item name="shapeAppearance">@style/ShapeAppearance.Suyu.Full</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/suyu_chip_background</item>
        <item name="android:textColor">@color/suyu_chip_text</item>
        <item name="checkedIcon">@drawable/ic_m3_check</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">?attr/colorOnSecondaryContainer</item>
        <item name="android:textAppearance">@style/TextAppearance.Suyu.LabelLarge</item>
        <!-- M3E: min chip height 32dp for comfortable tap target -->
        <item name="android:minHeight">@dimen/m3_chip_height</item>
        <item name="chipMinHeight">@dimen/m3_chip_height</item>
        <item name="chipMinTouchTargetSize">@dimen/m3_touch_target_size</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <!-- M3 Expressive nav active indicator: pill-shaped, primaryContainer fill. -->
    <style name="Widget.Suyu.NavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Suyu.NavActiveIndicator</item>
        <!-- M3E: wider pill indicator (64dp) for expressive visibility -->
        <item name="android:width">64dp</item>
    </style>

    <style name="ShapeAppearance.Suyu.NavActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
