<resources>

    <!--
        Material 3 Expressive wavy progress. The track height is the configurable dimension;
        amplitude and wave length control how strongly the line undulates.
    -->
    <declare-styleable name="WavyProgressIndicator">
        <attr name="wavyTrackThickness" format="dimension" />
        <attr name="wavyWaveAmplitude" format="dimension" />
        <attr name="wavyWaveLength" format="dimension" />
        <attr name="wavyIndeterminate" format="boolean" />
        <attr name="wavyTrackColor" format="color" />
        <attr name="wavyIndicatorColor" format="color" />
    </declare-styleable>

</resources>
