<?xml version="1.0" encoding="utf-8"?>
<!-- Shape language for the App layout presets (Settings > Interface look).

     Applied on top of the selected theme in ThemeHelper.setTheme(), so dialogs, sheets, menus and
     any card that reads its corner from the theme follow the same preset as the library. Cards that
     hardcode a radius are handled in code (see UiLayout.applyToCard).

     Every step of the M3 shape scale is overridden: Material's alert dialog and bottom sheet take
     their container shape from ?attr/shapeAppearanceCornerExtraLarge, while buttons and chips use
     the small steps. Overriding only Medium/Large left dialogs looking untouched. -->
<resources>

    <style name="ShapeAppearance.Sakura.Layout.Compact.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Sakura.Layout.Compact.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.Sakura.Layout.Compact.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Sakura.Layout.Compact.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.Sakura.Layout.Compact.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Sakura.Layout.Cinema.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
