<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 Expressive shape scale, matching ui/theme/SuyuM3.kt. -->
<resources>

    <style name="ShapeAppearance.Suyu.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.Suyu.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Suyu.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <!-- Artwork that sits flush against the top of a 16dp card: only the outer corners round. -->
    <style name="ShapeAppearance.Suyu.MediumTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearance.Suyu.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">22dp</item>
    </style>
    <style name="ShapeAppearance.Suyu.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>
    <style name="ShapeAppearance.Suyu.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>