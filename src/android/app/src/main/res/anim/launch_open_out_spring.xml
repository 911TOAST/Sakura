<?xml version="1.0" encoding="utf-8"?>
<!-- Springy game launch, outgoing launcher window: the content springs in on top, so the
     launcher only needs to duck out of the way quick and quiet. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true">
    <alpha
        android:duration="160"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
</set>
