<!-- Returning library: slides back in from the left while the panel leaves. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true"
    android:interpolator="@interpolator/m3_emphasized_decelerate">
    <translate
        android:duration="400"
        android:fromXDelta="-20%p"
        android:toXDelta="0" />
    <alpha
        android:duration="300"
        android:fromAlpha="0.85"
        android:toAlpha="1.0" />
</set>
