<!-- Incoming settings panel: slides in from the right on the M3 emphasized-decelerate curve. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true"
    android:interpolator="@interpolator/m3_emphasized_decelerate">
    <translate
        android:duration="400"
        android:fromXDelta="100%p"
        android:toXDelta="0" />
    <alpha
        android:duration="300"
        android:fromAlpha="0.75"
        android:toAlpha="1.0" />
</set>
